---
/**
 * 내 마감 (FR-032). 저장 목록은 localStorage에만 있으므로 전체 카드를 감춰
 * 렌더링하고 JS가 저장된 것만 드러낸다 — 별도 JSON 엔드포인트를 만들지 않는다.
 */
import Base from '../layouts/Base.astro';
import AppBar from '../components/AppBar.astro';
import CountdownCard from '../components/CountdownCard.astro';
import CalendarAdd from '../components/CalendarAdd.astro';
import Toast from '../components/Toast.astro';
import TabBar from '../components/TabBar.astro';
import { loadDeadlines } from '../lib/deadlines.ts';
import { loadTopics } from '../lib/topics.ts';
import { href } from '../lib/urls.ts';

const now = new Date();
const all = await loadDeadlines(now);
/*
 * 지난 마감도 렌더한다. 빌드 시점에 걸러 내면 저장해 둔 학회가 마감된 순간
 * 카드가 통째로 사라져, "저장 + 마감"일 때 뜨는 축하가 영영 뜨지 않는다.
 * 저장하지 않은 카드는 CSS가 감추므로 목록이 지저분해지지는 않는다.
 */
const saved = all.filter((item) => item.fullPaper !== null);

const { labelFor } = await loadTopics();
---

<Base title="내 마감 — Security & Software Engineering Conference Deadlines">
  <AppBar />

  <main class="page" data-my data-scroll>
    <h1 class="head" data-saved-head hidden>
      <span>저장한 마감 <span data-saved-count-text>0</span>건</span>
      <span class="rule" aria-hidden="true"></span>
    </h1>

    <div class="cards">
      {saved.map((item) => <CountdownCard item={item} topicLabel={labelFor(item)} now={now} />)}
    </div>

    <div class="empty" data-empty>
      <p class="empty-title">저장한 마감이 없습니다</p>
      <p class="empty-body">
        목록에서 카드의 <span class="mono">＋</span>를 눌러 추가하세요.
      </p>
      <a class="cta" href={href()}>목록으로</a>
    </div>

    <noscript>
      <p class="hint">내 마감은 브라우저에 저장되므로 JavaScript가 필요합니다.</p>
    </noscript>
  </main>

  <CalendarAdd />
  <Toast />
  <TabBar current="my" />
</Base>

<style>
  .page {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-behavior: smooth;
    padding: 0 16px 24px;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 18px 0 12px;
    font: 600 11px/14px var(--sans);
    letter-spacing: 0.09em;
    color: var(--ink3);
  }

  .head[hidden] {
    display: none;
  }

  .rule {
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* JS가 붙기 전에는 전부 감춰 둔다 — 저장 목록은 브라우저만 안다. */
  .cards :global(.saved) {
    display: none;
  }

  .cards :global(.saved[data-saved]) {
    display: block;
  }

  .hint {
    margin: 20px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font: 400 12px/18px var(--sans);
    color: var(--ink3);
  }

  .hint[hidden] {
    display: none;
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 120px 0 0;
  }

  .empty[hidden] {
    display: none;
  }

  .empty-title {
    margin: 0;
    font: 600 17px/22px var(--sans);
    letter-spacing: -0.02em;
  }

  .empty-body {
    margin: 0;
    font: 400 13px/20px var(--sans);
    color: var(--ink2);
  }

  .mono {
    font-family: var(--mono);
  }

  .cta {
    margin-top: 6px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0 16px;
    background: var(--brand);
    border-radius: 10px;
    color: #fff;
    font: 600 13px/1 var(--sans);
    text-decoration: none;
  }
</style>
