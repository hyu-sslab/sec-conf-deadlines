---
/** 앱바. 로고와 제목만 둔다 — 색은 D-day가 독점한다. */
import { href } from '../lib/urls.ts';
---

<header class="bar">
  <img
    class="logo light"
    src={href('logo-sslab.png')}
    width="199"
    height="52"
    alt="System Security Lab, Hanyang University"
  />
  <img
    class="logo dark"
    src={href('logo-sslab-dark.png')}
    width="199"
    height="52"
    alt="System Security Lab, Hanyang University"
  />
  <h1 class="title">
    <span class="scope">Security &amp; Software Engineering</span>
    <span class="name">Conference Deadlines</span>
  </h1>
  <button type="button" id="theme-toggle" aria-label="테마 전환" title="테마">
    <span class="moon" aria-hidden="true">☾</span>
    <span class="sun" aria-hidden="true">☀</span>
  </button>
</header>

<style>
  .bar {
    flex: none;
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 52px;
    padding: 4px 2px 4px 14px;
    border-bottom: 1px solid var(--rule);
  }

  /*
   * 로고의 'Lab'은 알파 42% 검정이라 흰 배경 위에서만 회색으로 합성된다.
   * 어두운 배경에서는 필터로 살릴 수 없어 다크 전용 이미지를 따로 쓴다.
   */
  .logo {
    flex: none;
    width: auto;
    height: 25px;
  }

  .logo.dark,
  #theme-toggle .sun {
    display: none;
  }

  /* ☀ 는 ☾ 보다 획이 가늘어 같은 크기로는 흐려 보인다. */
  #theme-toggle .sun {
    font-size: 20px;
  }

  :global(html[data-theme='dark']) .logo.light,
  :global(html[data-theme='dark']) #theme-toggle .moon {
    display: none;
  }

  :global(html[data-theme='dark']) .logo.dark,
  :global(html[data-theme='dark']) #theme-toggle .sun {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .logo.light,
    :global(html:not([data-theme='light'])) #theme-toggle .moon {
      display: none;
    }

    :global(html:not([data-theme='light'])) .logo.dark,
    :global(html:not([data-theme='light'])) #theme-toggle .sun {
      display: block;
    }
  }

  .title {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0;
  }

  .scope {
    /* 줄 높이를 넉넉히 준다 — overflow:hidden은 세로로도 자르므로
       디센더(g·y·p)가 line-box를 넘으면 꼬리가 깎인다. */
    font: 600 10px/15px var(--sans);
    letter-spacing: -0.015em;
    color: var(--ink2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .name {
    font: 700 16px/21px var(--sans);
    letter-spacing: -0.035em;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 44×44 — 터치 타겟 최소 기준 (NFR-005) */
  #theme-toggle {
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    color: var(--ink2);
    font-size: 17px;
    line-height: 1;
    cursor: pointer;
  }
</style>
