---
/**
 * 내 마감 전용 카드. 목록과 일부러 다르게 만든다 — 여기 있는 학회는 이미
 * 내기로 정한 것이라 남은 시간을 초 단위까지 봐야 한다 (decisions.md B-10).
 */
import type { Deadline } from '../lib/deadlines.ts';
import { urgencyTier } from '../lib/config.ts';
import { googleEventUrl, icsSlug } from '../lib/ics.ts';
import { editionTitle } from '../lib/title.ts';
import { href } from '../lib/urls.ts';
import { MS, splitRemaining } from '../lib/dates.ts';

interface Props {
  item: Deadline;
  topicLabel: string;
  now: Date;
}

const { item, topicLabel, now } = Astro.props;
const deadline = item.fullPaper!;

const title = editionTitle(item);
const tier = item.dday === null ? 3 : urgencyTier(item.dday);
const icore = item.conference.ranks.icore.rank;
const grade = item.conference.ranks.internal.grade;

const icsPath = href(`ics/${icsSlug(item.key)}.ics`);
const googleUrl = googleEventUrl(item);

const remaining = deadline.instant.getTime() - now.getTime();
const { days, hours, minutes, seconds } = splitRemaining(remaining);

/*
 * 24시간이 경계다. 초는 항상 보이고, 하루가 남지 않았으면 '일'만 뺀다 —
 * 어차피 0이라 자리만 차지한다.
 */
const lastDay = remaining < MS.day;
---

<article class="saved" data-key={item.key} data-countdown={deadline.instant.toISOString()}>
  <header>
    <div class="titles">
      <div class="head-line">
        <h3>{title}</h3>
        <span class="stamp" aria-hidden="true">마감</span>
      </div>
      <div class="badges">
        {icore && <span class="badge">ICORE {icore}</span>}
        {grade && <span class="badge">교내 {grade}</span>}
      </div>
    </div>
    <button
      class="icon trash"
      type="button"
      data-save={item.key}
      data-remove
      aria-label={`${title} 내 마감에서 제거`}
      title="내 마감에서 제거"
    >
      <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor"
           stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2.6 4.2h10.8" />
        <path d="M6.4 4.2V2.8h3.2v1.4" />
        <path d="M4.1 4.2l.66 8.9a.9.9 0 0 0 .9.83h4.68a.9.9 0 0 0 .9-.83l.66-8.9" />
        <path d="M6.7 6.9v4.3M9.3 6.9v4.3" />
      </svg>
    </button>
  </header>

  <div class="clock" data-tier={tier} role="timer" aria-live="off">
    <div class="unit" data-unit-days hidden={lastDay || undefined}>
      <span class="num" data-days>{days}</span>
      <span class="cap">일</span>
    </div>
    <div class="unit">
      <span class="num" data-hours>{String(hours).padStart(2, '0')}</span>
      <span class="cap">시간</span>
    </div>
    <div class="unit">
      <span class="num" data-minutes>{String(minutes).padStart(2, '0')}</span>
      <span class="cap">분</span>
    </div>
    <div class="unit seconds">
      <span class="num" data-seconds>{String(seconds).padStart(2, '0')}</span>
      <span class="cap">초</span>
    </div>
  </div>

  {/* 마감이 지나면 카드 아랫부분이 통째로 이 축하 면으로 바뀐다. */}
  <div class="over" data-closed hidden>
    <div class="confetti" aria-hidden="true">
      <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
    </div>
    {/*
      src를 비워 둔다. 이 페이지는 마감이 있는 학회를 전부 그리므로 이 태그가
      수십 개 생기는데, src가 박혀 있으면 축하 면이 한 번도 안 뜨는 방문자도
      브라우저가 그림을 받아 온다 (요소마다 한 번씩). 저장해 둔 학회가 실제로
      마감됐을 때 클라이언트가 붙인다.
    */}
    <img
      class="cat"
      data-cat={href('soju-cat.webp')}
      width="240"
      height="149"
      alt=""
      decoding="async"
    />
    <p class="line">한 잔 해야지…</p>
  </div>

  <dl>
    <dt>마감</dt>
    <dd><span class="mono">{deadline.kst}</span> <span class="tz">KST</span></dd>
    <dt>통보</dt>
    <dd><span class="mono">{item.notification ?? '미수집'}</span></dd>
    <dt>분야</dt>
    <dd>{topicLabel}</dd>
  </dl>

  <footer>
    <a href={item.sourceUrl} rel="noopener">CFP 원문</a>
    <button
      class="addcal"
      type="button"
      data-add-cal
      data-cal-google={googleUrl}
      data-cal-ics={icsPath}
    >캘린더에 추가</button>
  </footer>
</article>

<style>
  .saved {
    background: var(--card);
    border-radius: 12px;
    padding: 16px;
  }

  header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .titles {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  /* 44px 터치 목표를 지키고, 음수 마진으로 시각적 정렬만 맞춘다. */
  .icon {
    flex: none;
    margin: -10px -10px 0 0;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    border-radius: 999px;
    color: var(--ink3);
    cursor: pointer;
  }

  .icon:hover,
  .icon:focus-visible {
    color: var(--brand);
  }

  /* 파괴적 동작이라 되돌아오는 색이 다르다. */
  .trash:hover,
  .trash:focus-visible {
    color: var(--u1);
  }

  .head-line {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  h3 {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: 600 17px/22px var(--sans);
    letter-spacing: -0.02em;
  }

  /*
   * 마감 도장. 크게 떠서 쿵 내려앉는다 — 도장이 찍히는 동작이다.
   * 기울여 두면 인쇄물이 아니라 손으로 찍은 느낌이 난다.
   */
  .stamp {
    flex: none;
    display: none;
    padding: 1px 6px;
    border: 2px solid var(--u1);
    border-radius: 5px;
    color: var(--u1);
    font: 700 12px/1.4 var(--sans);
    letter-spacing: -0.01em;
  }

  .saved[data-expired] .stamp {
    display: block;
    animation: nx-thud 0.42s cubic-bezier(0.2, 0.9, 0.25, 1) 0.15s both;
  }

  @keyframes nx-thud {
    0% { opacity: 0; transform: scale(2.6); }
    55% { opacity: 1; transform: scale(0.92); }
    100% { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .saved[data-expired] .stamp { animation: none; }
  }

  .badges {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }


  /* 남은 시간이 이 카드의 주인공이다. */
  .clock {
    display: flex;
    align-items: baseline;
    gap: 11px;
    margin: 16px 0 4px;
  }

  .unit {
    display: flex;
    align-items: baseline;
    gap: 3px;
  }

  .unit[hidden],
  .clock[hidden] {
    display: none;
  }

  .num {
    font: 700 28px/1 var(--mono);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .cap {
    font: 400 12px/1 var(--sans);
    color: var(--ink3);
  }

  /* 초는 매초 바뀐다. 폭이 흔들리면 옆 숫자가 따라 밀리므로 자리를 잡아둔다. */
  .seconds .num {
    min-width: 2ch;
    text-align: right;
  }

  .clock[data-tier='1'] .num { color: var(--u1); }
  .clock[data-tier='2'] .num { color: var(--u2); }
  .clock[data-tier='3'] .num { color: var(--u3); }

  /*
   * 마감이 지난 카드. 남은 시간도 캘린더 추가도 의미가 없어졌으므로
   * 아래를 통째로 덮는다. 음수 마진으로 카드 안쪽 여백까지 채운다.
   */
  .over {
    position: relative;
    margin: 16px -16px -16px;
    padding: 20px 16px 18px;
    background: var(--brand-soft);
    overflow: hidden;
    text-align: center;
    animation: nx-wash 0.4s ease 0.1s both;
  }

  .over[hidden] {
    display: none;
  }

  .cat {
    position: relative;
    z-index: 1;
    width: 150px;
    height: auto;
    animation: nx-rise 0.6s cubic-bezier(0.2, 1.25, 0.35, 1) 0.25s both;
  }

  .line {
    position: relative;
    z-index: 1;
    margin: 2px 0 0;
    font: 700 30px/1.2 var(--fun);
    letter-spacing: -0.01em;
    color: var(--brand);
    animation: nx-rise 0.5s cubic-bezier(0.2, 1.2, 0.35, 1) 0.5s both;
  }

  .confetti {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .confetti i {
    position: absolute;
    top: -14px;
    width: 7px;
    height: 11px;
    border-radius: 1px;
    animation: nx-fall 3s linear infinite;
  }

  /* 색·위치를 흩어 놓고, 지연은 음수로 준다.
     양수면 에그가 뜬 직후 패널이 비어 있다가 뒤늦게 하나씩 떨어진다.
     음수면 첫 프레임부터 이미 위아래로 흩날리는 상태다. */
  .confetti i:nth-child(1) { left: 6%;  background: var(--u1); animation-delay: -0.15s; }
  .confetti i:nth-child(2) { left: 15%; background: var(--u2); animation-delay: -1.45s; }
  .confetti i:nth-child(3) { left: 27%; background: var(--u3); animation-delay: -0.75s; }
  .confetti i:nth-child(4) { left: 39%; background: var(--u2); animation-delay: -2.25s; }
  .confetti i:nth-child(5) { left: 50%; background: var(--u1); animation-delay: -1.05s; }
  .confetti i:nth-child(6) { left: 61%; background: var(--u3); animation-delay: -1.95s; }
  .confetti i:nth-child(7) { left: 73%; background: var(--u2); animation-delay: -0.45s; }
  .confetti i:nth-child(8) { left: 84%; background: var(--u1); animation-delay: -2.55s; }
  .confetti i:nth-child(9) { left: 93%; background: var(--u3); animation-delay: -1.65s; }

  @keyframes nx-wash {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes nx-rise {
    from { opacity: 0; transform: translateY(14px) scale(0.9); }
    to { opacity: 1; transform: none; }
  }

  @keyframes nx-fall {
    0% { opacity: 0; transform: translateY(-14px) rotate(0); }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { opacity: 0; transform: translateY(260px) rotate(520deg); }
  }

  /* 흔들림을 원치 않는 사용자에게는 색종이를 떨어뜨리지 않는다. */
  @media (prefers-reduced-motion: reduce) {
    .over, .cat, .line { animation: none; }
    .confetti { display: none; }
  }

  /* 지난 마감에는 남은 시간도, 일정 정보도, 캘린더 추가도 필요 없다. */
  .saved[data-expired] dl,
  .saved[data-expired] footer {
    display: none;
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 14px;
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
  }

  dt {
    font: 400 12px/26px var(--sans);
    color: var(--ink3);
  }

  dd {
    margin: 0;
    min-width: 0;
    font: 500 12px/26px var(--sans);
    text-align: right;
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    gap: 5px;
  }

  .mono { font-family: var(--mono); }
  .tz { font: 400 11px/26px var(--sans); color: var(--ink3); }

  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
  }

  footer a {
    font: 400 12px/18px var(--sans);
    color: var(--ink3);
  }

  /* 주 동작이라 브랜드색을 준다. --brand는 라이트/다크 모두 카드 위에서 7:1을 넘는다. */
  .addcal {
    border-color: var(--brand) !important;
    color: var(--brand) !important;
  }

  footer button {
    height: 32px;
    padding: 0 12px;
    background: none;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink2);
    font: 500 12px/1 var(--sans);
    cursor: pointer;
  }
</style>
