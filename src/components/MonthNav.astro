---
/**
 * 월 네비게이터 (FR-018). 앵커 링크라 JS 없이 동작한다 — 클릭은 '필터'가
 * 아니라 '점프'다. 0건인 월도 자리를 지켜 시간 축의 연속성을 보존한다.
 */
interface MonthCell {
  key: string;
  label: string;
  count: number;
  /** 기본 탐색 범위 안인가. 밖이면 렌더링은 하되 감춰 둔다. */
  inDefault: boolean;
}

import { MONTH_BAR, monthBarHeight } from '../lib/config.ts';

interface Props {
  months: MonthCell[];
  activeKey: string | null;
}

const { months, activeKey } = Astro.props;
const peak = Math.max(1, ...months.filter((m) => m.inDefault).map((m) => m.count));
---

<nav class="nav nx-scroll" aria-label="월별 마감 건수" style={`--bar-max:${MONTH_BAR.maxHeight}px`}>
  {
    months.map((month) => {
      const active = month.key === activeKey;
      const Tag = month.count === 0 ? 'span' : 'a';
      return (
        <Tag
          class="cell"
          data-month={month.key}
          hidden={month.inDefault ? undefined : true}
          data-active={active ? '' : undefined}
          data-empty={month.count === 0 ? '' : undefined}
          {...(month.count === 0 ? {} : { href: `#month-${month.key}` })}
          aria-current={active ? 'true' : undefined}
        >
          <span class="label">{month.label}</span>
          <span class="count" data-count>{month.count}</span>
          <span class="barbox">
            <span class="bar" data-bar style={`height:${monthBarHeight(month.count, peak)}px`} />
          </span>
        </Tag>
      );
    })
  }
</nav>

<style>
  .nav {
    flex: none;
    display: flex;
    gap: 2px;
    overflow-x: auto;
    padding: 8px 12px 0;
  }

  .cell {
    flex: none;
    width: 46px;
    height: 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 2px;
    padding: 0 0 5px;
    border-bottom: 2px solid transparent;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .cell[data-active] {
    border-bottom-color: var(--ink);
  }

  .cell[data-empty] {
    opacity: 0.55;
    cursor: default;
    pointer-events: none;
  }

  /* 기간 필터 밖의 달은 렌더링하지 않는다 (요구사항 6.4) */
  .cell[hidden] {
    display: none;
  }

  .label {
    font: 400 12px/15px var(--sans);
    color: var(--ink2);
  }

  .cell[data-active] .label {
    font-weight: 600;
    color: var(--ink);
  }

  .count {
    font: 600 13px/16px var(--mono);
    letter-spacing: -0.03em;
    color: var(--ink2);
  }

  .cell[data-active] .count {
    color: var(--ink);
  }

  .cell[data-empty] .count {
    color: var(--ink3);
  }

  /*
   * flex: none이 아니면 셀 높이에 눌려 상자가 줄고, 막대가 잘려 밀도 차이가
   * 사라진다. overflow는 마지막 방어선이다 — 계산이 틀려도 건수를 덮지 못한다.
   */
  .barbox {
    flex: none;
    display: flex;
    align-items: flex-end;
    height: var(--bar-max);
    overflow: hidden;
  }

  /* 밀도 막대는 무채색으로 남긴다 — 색은 D-day가 독점한다. */
  .bar {
    display: block;
    width: 20px;
    background: var(--bar);
    border-radius: 2px;
  }

  .cell[data-active] .bar {
    background: var(--brand);
  }
</style>
