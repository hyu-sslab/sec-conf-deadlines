---
/**
 * 지난 마감 항목. 펼치면 같은 학회의 다음 마감(없으면 추정)과 같은 분야에서
 * 지금 열려 있는 마감을 준다 (FR-020~022). <details>라 JS 없이 동작한다.
 */
import type { Deadline, Recommendation } from '../lib/deadlines.ts';
import { urgencyTier, RELAXED_TIER } from '../lib/deadlines.ts';
import { editionTitle } from '../lib/title.ts';

interface Props {
  item: Deadline;
  recommendation: Recommendation;
}

const { item, recommendation } = Astro.props;

const titleOf = (d: Deadline) => editionTitle(d);

const next = recommendation.nextEdition ?? recommendation.estimatedNextEdition;
const { alternatives } = recommendation;
const { items: alts, sameField } = alternatives;
---

<details class="past-item">
  <summary>
    <span class="name">{titleOf(item)}</span>
    <span class="closed">마감됨</span>
  </summary>

  <div class="body">
    {
      next && (
        <section>
          <h4><span aria-hidden="true">↻</span> 다음 사이클</h4>
          <div class="next">
            <span class="next-name">{titleOf(next)}</span>
            <span class="next-date">{next.fullPaper?.raw.slice(0, 10) ?? '미정'}</span>
            {next.isEstimated && <span class="tag">예상</span>}
          </div>
        </section>
      )
    }

    {
      alts.length > 0 && (
        <section>
          <h4>
            <span aria-hidden="true">↗</span>
            {sameField ? '같은 분야 · 지금 열려 있는 마감' : '다른 분야 · 지금 열려 있는 마감'}
          </h4>
          {!sameField && (
            <p class="hint">같은 분야에 열려 있는 마감이 없어 분야를 넓혔습니다.</p>
          )}
          <ul class="alts">
            {alts.map((alt) => (
              <li>
                <span class="alt-name">{titleOf(alt)}</span>
                <span class="alt-rank">{alt.conference.ranks.icore.rank ?? ''}</span>
                <span class="alt-date">{alt.fullPaper!.date.month}/{alt.fullPaper!.date.day}</span>
                <span class="alt-dday" data-tier={alt.dday === null ? RELAXED_TIER : urgencyTier(alt.dday)}>D-{alt.dday}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      !next && alts.length === 0 && (
        <p class="none">다음 일정도, 같은 분야에 열려 있는 마감도 아직 없습니다.</p>
      )
    }
  </div>
</details>

<style>
  /*
   * 지난 마감은 24건이 한 줄로 쌓인다. 카드 배경(#F2F6FB)과 화면 배경
   * (#FCFDFE)의 차이가 작아 접힌 상태에서는 서로 붙어 보였다.
   * 테두리로 경계를 세우고 여백을 늘려 항목 단위를 분명히 한다.
   */
  .past-item {
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 12px;
  }

  .past-item[open] {
    border-color: var(--ink3);
    background: var(--bg);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 48px;
    padding: 12px 14px;
    cursor: pointer;
    list-style: none;
  }

  summary::after {
    content: '▸';
    flex: none;
    font-size: 9px;
    color: var(--ink3);
  }

  .past-item[open] summary::after {
    content: '▾';
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .name {
    font: 600 17px/22px var(--sans);
    letter-spacing: -0.02em;
    color: var(--ink2);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .closed {
    flex: none;
    font: 400 12px/16px var(--sans);
    color: var(--ink3);
  }

  .past-item[open] .name {
    color: var(--ink);
  }

  .body {
    padding: 0 16px 18px;
  }

  section {
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }

  section + section {
    margin-top: 20px;
  }

  h4 {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    font: 600 11px/14px var(--sans);
    letter-spacing: 0.09em;
    color: var(--ink3);
  }

  .next {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .next-name {
    font: 600 17px/22px var(--sans);
    letter-spacing: -0.02em;
  }

  .next-date {
    font: 400 13px/18px var(--mono);
    color: var(--ink2);
  }

  .tag {
    border: 1px dashed var(--ink3);
    color: var(--ink3);
    font: 500 11px/14px var(--sans);
    padding: 1px 5px;
    border-radius: 4px;
  }

  .notify {
    display: inline-flex;
    align-items: center;
    margin-top: 11px;
    height: 36px;
    padding: 0 12px;
    border: 1px solid var(--brand);
    border-radius: 999px;
    color: var(--brand);
    font: 500 12px/1 var(--sans);
    text-decoration: none;
  }

  .hint {
    margin: 6px 0 0;
    font: 400 12px/16px var(--sans);
    color: var(--ink3);
  }

  .alts {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    gap: 0 10px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .alts li {
    display: contents;
  }

  .alts {
    gap: 2px 10px;
  }

  .alt-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: 600 15px/30px var(--sans);
    letter-spacing: -0.02em;
  }

  .alt-rank {
    font: 700 11px/30px var(--mono);
    color: var(--ink3);
  }

  .alt-date {
    font: 400 12px/30px var(--mono);
    color: var(--ink3);
  }

  .alt-dday {
    font: 700 12px/30px var(--mono);
  }

  .alt-dday[data-tier='1'] { color: var(--u1); }
  .alt-dday[data-tier='2'] { color: var(--u2); }
  .alt-dday[data-tier='3'] { color: var(--u3); }

  .none {
    margin: 13px 0 0;
    padding-top: 13px;
    border-top: 1px solid var(--rule);
    font: 400 13px/20px var(--sans);
    color: var(--ink3);
  }
</style>
