---
/**
 * "캘린더에 추가" 팝업. 카드의 버튼이 열고, 링크는 JS가 그 카드 값으로 채운다.
 *
 *   구글    일정을 미리 채운 등록 화면이 열린다 (구독이 아니다)
 *   애플    일정을 넣는 URL이 없다. .ics를 열면 캘린더가 "추가"를 띄운다
 *
 * 네이버는 뺐다. 링크로 일정을 넣는 방법이 없고 OAuth API뿐이라 정적 사이트에서는
 * 구현할 수 없다.
 */
---

<dialog class="pop" id="cal-sheet" aria-labelledby="cal-title" tabindex="-1">
  <div class="head">
    <h2 id="cal-title">캘린더에 추가</h2>
    <button class="x" type="button" data-close-cal aria-label="닫기">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M4 4l8 8M12 4l-8 8" />
      </svg>
    </button>
  </div>

  <a class="pick" data-pick-google target="_blank" rel="noopener">
    <svg class="mark" viewBox="0 0 20 20" aria-hidden="true">
      <rect x="2.6" y="4.2" width="14.8" height="13.2" rx="2.2" />
      <path d="M2.6 8.1h14.8" />
      <path d="M6.7 2.6v3.1M13.3 2.6v3.1" />
      <path d="M10 10.8v3.8M8.1 12.7h3.8" />
    </svg>
    <span>Google 캘린더 추가</span>
  </a>

  <a class="pick" data-pick-apple>
    <svg class="mark" viewBox="0 0 20 20" aria-hidden="true">
      <rect x="2.6" y="4.2" width="14.8" height="13.2" rx="2.2" />
      <path d="M2.6 8.1h14.8" />
      <path d="M6.7 2.6v3.1M13.3 2.6v3.1" />
      <path d="M10 10.6v3.9M8.3 12.9l1.7 1.6 1.7-1.6" />
    </svg>
    <span data-apple-label>Apple 캘린더 추가</span>
  </a>
</dialog>

<style>
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 14px;
  }

  h2 {
    margin: 0;
    font: 700 16px/22px var(--sans);
    letter-spacing: -0.02em;
  }

  /* 음수 마진으로 44px 터치 목표를 지키면서 시각적 정렬만 맞춘다. */
  .x {
    flex: none;
    width: 44px;
    height: 44px;
    margin: -11px -11px -11px 0;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    border-radius: 999px;
    color: var(--ink3);
    cursor: pointer;
  }

  .x svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /*
   * 채운 버튼을 쓰지 않는다. --brand는 라이트에서 진한 파랑(#0E4A84),
   * 다크에서 연한 파랑(#8FBCE8)이라 배경으로 쓰면 전경색을 테마마다 뒤집어야
   * 한다. 테두리·글자색으로 쓰면 양쪽 다 7:1 이상이 나온다.
   */
  .pick {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 50px;
    padding: 0 16px;
    background: none;
    border: 1px solid var(--brand);
    border-radius: 12px;
    color: var(--brand);
    font: 600 14px/1 var(--sans);
    text-decoration: none;
  }

  .pick + .pick {
    margin-top: 8px;
  }

  .mark {
    flex: none;
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
