---
/**
 * 접기·펼치기 표시. `<details>`가 열리면 90도 돌아간다.
 *
 * 예전에는 `▸`/`▾` 글리프였는데 9px이라 눈에 띄지 않았고, 여는 순간 글자가
 * 통째로 바뀌어 전환을 줄 수 없었다.
 *
 * `down`은 상태가 없는 자리에 쓴다 — 드롭다운 표시처럼 늘 아래를 가리키는 곳.
 */
interface Props {
  down?: boolean;
}

const { down = false } = Astro.props;
---

<svg class:list={['chevron', { down }]} viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
  <path d="M6 3.5L10.5 8L6 12.5" />
</svg>

<style>
  .chevron {
    flex: none;
    fill: none;
    stroke: var(--ink2);
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.18s ease;
  }

  .chevron.down,
  :global(details[open]) > :global(summary) .chevron {
    transform: rotate(90deg);
  }
</style>
