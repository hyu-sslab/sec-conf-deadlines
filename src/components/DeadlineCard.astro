---
/**
 * 목록 항목. 카드에는 날짜·학회명·등급·D-day 넷만 남기고, 나머지는
 * <template>에 담아 상세 시트가 복제해 연다 (decisions.md B-7).
 * 날짜는 전부 KST 기준이다 (B-6).
 */
import type { Deadline } from '../lib/deadlines.ts';
import { urgencyTier } from '../lib/deadlines.ts';
import { editionTitle } from '../lib/title.ts';

interface Props {
  item: Deadline;
  topicLabel: string;
}

const { item, topicLabel } = Astro.props;
const deadline = item.fullPaper!;

const day = String(deadline.date.day).padStart(2, '0');
const title = editionTitle(item);
const tier = item.dday === null ? 3 : urgencyTier(item.dday);

const icore = item.conference.ranks.icore.rank;
const grade = item.conference.ranks.internal.grade;
const sciEquivalent = item.conference.ranks.bk21.sci_equivalent;

/** 클라이언트 필터·상세 시트가 읽는 값. 별도 JSON을 내보내지 않기 위해
 *  데이터를 DOM 속성에 싣는다 (브리프 §4-④). */
const filterAttrs = {
  'data-key': item.key,
  'data-name': `${item.conference.name} ${item.conference.full_name ?? ''}`.toLowerCase(),
  'data-month': item.monthKey ?? '',
  'data-dday': String(item.dday ?? ''),
  'data-icore': icore ?? '',
  'data-grade': grade ?? '',
  'data-topics': item.conference.topics.join(' '),
  'data-source': item.sourceUrl,
  ...(item.isEstimated ? { 'data-estimated': '' } : {}),
};

const CONFIDENCE_LABEL = {
  verified: '사람이 확인',
  auto: '자동 수집',
  estimated: '추정값',
} as const;
---

<div class="row" {...filterAttrs}>
  <div class="day">
    <div class="num">{day}</div>
    <div class="unit">일</div>
  </div>

  <div class="axis" aria-hidden="true">
    <span class="dot"></span>
    <span class="line"></span>
  </div>

  <article class="card" data-card>
    <div class="head">
      <h3 class="name" data-title>{title}</h3>
      {
        item.dday === null ? (
          <span class="estimated">예상</span>
        ) : (
          <span class="dday" data-tier={tier}>D-{item.dday}</span>
        )
      }

      <div class="meta">
        {icore && <span class="badge">ICORE {icore}</span>}
        {grade && <span class="badge">교내 {grade}</span>}
      </div>

      {
        !item.isEstimated && (
          <button
            class="save"
            type="button"
            data-save={item.key}
            aria-label={`${title} 내 마감에 추가`}
            title="내 마감에 추가"
            hidden
          >＋</button>
        )
      }
    </div>

    <template data-detail>
      <dl>
        <dt>{item.isEstimated ? '예상 마감' : '마감'}</dt>
        <dd>
          <span class="mono">{deadline.kst}</span>
          <span class="tz">KST</span>
        </dd>

        {item.abstract && <dt>초록</dt>}
        {item.abstract && <dd><span class="mono">{item.abstract.kst}</span><span class="tz">KST</span></dd>}

        <dt>통보</dt>
        <dd><span class="mono">{item.notification ?? '미수집'}</span></dd>

        {item.conferenceDate && <dt>학회 기간</dt>}
        {item.conferenceDate && <dd><span class="mono">{item.conferenceDate}</span></dd>}

        {item.place && <dt>장소</dt>}
        {item.place && <dd>{item.place}</dd>}

        <dt>분야</dt>
        <dd>{topicLabel}</dd>

        {sciEquivalent !== null && <dt>BK21</dt>}
        {
          sciEquivalent !== null && (
            <dd>{sciEquivalent ? 'SCI급 학술대회 인정' : '미해당'}</dd>
          )
        }
      </dl>

      <p class="source">
        <a href={item.sourceUrl} rel="noopener">CFP 원문</a>
        {item.conference.dblp && <> · <a href={item.conference.dblp} rel="noopener">dblp</a></>}
        <span class="stamp">
          {CONFIDENCE_LABEL[item.confidence]} · {item.lastVerifiedAt}
        </span>
      </p>
    </template>
  </article>
</div>

<style>
  .row[hidden] {
    display: none;
  }

  .row {
    display: grid;
    grid-template-columns: 40px 14px 1fr;
    column-gap: 8px;
    padding-bottom: 8px;
  }

  /* ① 날짜 — 월별 리스트에서 1차 시선 앵커 */
  .day {
    text-align: right;
    padding-top: 11px;
  }

  .num {
    font: 700 22px/24px var(--mono);
    letter-spacing: -0.045em;
  }

  .unit {
    font: 400 11px/14px var(--sans);
    color: var(--ink3);
  }

  /* ② 시간 축 */
  .axis {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 18px;
  }

  /* 시간 축은 임박도를 나타내지 않는다 — 색은 D-day 하나가 독점한다. */
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--brand);
  }

  .line {
    width: 1px;
    flex: 1;
    background: var(--rule);
  }

  .card[data-interactive] {
    cursor: pointer;
  }


  .card {
    min-width: 0;
    background: var(--card);
    border-radius: 12px;
    padding: 14px 14px 12px;
  }

  .head {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 10px;
    row-gap: 10px;
    align-items: baseline;
  }

  .name {
    min-width: 0;
    margin: 0;
    font: 600 17px/22px var(--sans);
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ③ D-day — 화면에서 유일하게 채도가 높은 요소 */
  .dday {
    justify-self: end;
    font: 700 17px/22px var(--mono);
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .estimated {
    justify-self: end;
    border: 1px dashed var(--ink3);
    color: var(--ink3);
    font: 500 11px/14px var(--sans);
    padding: 1px 5px;
    border-radius: 4px;
  }

  .dday[data-tier='1'] { color: var(--u1); }
  .dday[data-tier='2'] { color: var(--u2); }
  .dday[data-tier='3'] { color: var(--u3); }

  .meta {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    flex-wrap: wrap;
  }

  /*
   * 두 등급은 서로 다른 것을 재므로 축 이름을 함께 적는다. 예전에는 채움형과
   * 외곽선형으로 형태를 갈랐지만, 라벨이 있으면 형태로 구분할 이유가 없다 —
   * 오히려 "A*"만 있으면 어느 체계의 A*인지 알 수 없었다.
   */
  .badge {
    flex: none;
    display: flex;
    align-items: center;
    height: 20px;
    padding: 0 7px;
    border: 1px solid var(--ink3);
    border-radius: 4px;
    color: var(--ink2);
    font: 500 11px/1 var(--sans);
    white-space: nowrap;
  }


  /* 우측 수치 축을 D-day와 공유한다. 32px이라 텍스트와 떨어져 오탭이 없다. */
  .save {
    justify-self: end;
    align-self: center;
    width: 32px;
    height: 32px;
    margin: -6px -8px -6px 0;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    border-radius: 999px;
    color: var(--ink3);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
  }

  .save[data-on] {
    background: var(--brand-soft);
    color: var(--brand);
    font-size: 14px;
  }


  .mono {
    font-family: var(--mono);
  }

  .tz {
    font: 400 11px/28px var(--sans);
    color: var(--ink3);
  }

  .source {
    margin: 10px 0 0;
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
    font: 400 12px/18px var(--sans);
    color: var(--ink3);
  }

  .stamp {
    margin-left: auto;
  }
</style>
