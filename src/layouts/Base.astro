---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/badge.css';
import '../styles/dialog.css';

interface Props {
  title?: string;
  description?: string;
}

const SITE = 'Security & Software Engineering Conference Deadlines';

const {
  title = SITE,
  description = '보안·소프트웨어공학 국제 학회의 마감과 통보 일정을 한 화면에서 확인한다.',
} = Astro.props;

import { href } from '../lib/urls.ts';

/*
 * 링크 미리보기(Open Graph).
 *
 * og:image와 og:url은 절대 URL이어야 한다 — 카카오톡·슬랙은 상대 경로를
 * 읽지 못한다. astro.config의 site가 그 절대 주소의 출처다.
 */
const ogImage = new URL(href('og.png'), Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={href('favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={href('favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={href('favicon-16x16.png')} />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    <link rel="manifest" href={href('site.webmanifest')} />
    <meta name="theme-color" content="#0E4A84" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SecSE Deadlines" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&family=Gaegu:wght@700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
    />

    {/* 저장된 테마를 페인트 전에 적용한다. 나중에 붙이면 화면이 한 번 번쩍인다.
        모듈을 불러오기 전이라 키를 그대로 적는다 — `client/storage.ts`의 THEME_KEY와 같아야 한다. */}
    <script is:inline>
      document.documentElement.dataset.js = '';
      try {
        const saved = localStorage.getItem('nx-theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>
  </head>

  <body>
    <div class="app">
      <slot />
    </div>

    <script>
      import { startCalendarAdd } from '../client/calendar-add.ts';
      import { startCountdown, startDeadlineRefresh } from '../client/deadline-time.ts';
      import { startDetailSheet } from '../client/detail-sheet.ts';
      import { startFilters } from '../client/filters.ts';
      import { startMonthNav } from '../client/month-nav.ts';
      import { armCat, startSavedList } from '../client/saved.ts';
      import { startTabBarAutoHide } from '../client/tabbar.ts';
      import { startThemeToggle } from '../client/theme.ts';
      import { startYearPager } from '../client/year-pager.ts';

      /*
       * 화면 기능은 전부 `src/client/`에 있다. 여기는 무엇을 언제 켜는지만 정한다.
       * 각 모듈은 자기 마크업이 없는 페이지에서는 조용히 아무것도 하지 않는다.
       */
      startThemeToggle();

      // 만료 표시를 먼저 세운다 — 저장 버튼과 상세 시트가 `data-expired`를 읽는다.
      startDeadlineRefresh();
      startSavedList();
      startCountdown(armCat);

      startDetailSheet();
      startCalendarAdd();
      startFilters();
      startMonthNav();
      startTabBarAutoHide();
      startYearPager();
    </script>
  </body>
</html>
